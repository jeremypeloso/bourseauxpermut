# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Secrets applicatifs (générer avec : openssl rand -hex 32)
IDENTITIES_KEY=            # clé AES-256 de chiffrement des identités (64 hex)
MATRICULE_PEPPER=          # poivre du hachage matricule (64 hex)
CRON_SECRET=               # protège /api/cron/matching

# Resend
RESEND_API_KEY=re_...
EMAIL_FROM="La Bourse aux permut' <noreply@labourseauxpermut.fr>"

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...        # abonnement 9,99 €/mois
STRIPE_BOOST_PRICE_ID=price_...  # mise en avant d'annonce 4,99 €, paiement unique

# Site
NEXT_PUBLIC_SITE_URL=https://labourseauxpermut.fr

# Prélancement : 1 = page d'accueil en mode pré-inscription (pas d'inscription publique)
NEXT_PUBLIC_PRELAUNCH=1
# Date d'ouverture affichée avec le décompte
NEXT_PUBLIC_OUVERTURE=2026-10-23T08:00:00+02:00
# Institutions ouvertes à l'inscription (PN, puis PN,GN,AP)
NEXT_PUBLIC_INSTITUTIONS=PN
# Offre de lancement (1 mois Premium aux 100 premiers vérifiés) : 0 pour masquer la mention une fois le quota atteint
NEXT_PUBLIC_OFFRE_LANCEMENT=1
